#!/usr/bin/python3
"""Tokens spent inside the current rate-limit window.

The packaged collector buckets transcript usage by calendar day, which is the
wrong unit for a five-hour window that opened at some arbitrary time. This
walks the same transcripts and sums only the assistant turns that land after a
cutoff, so the bar can say what the session itself has cost.

Usage:  session-tokens <session-cutoff-epoch> [today-cutoff-epoch]

Prints one JSON object of named buckets:

    {"session": {"tokens", "prompts", "byModel", "sessions"},
     "today":   {...}}                 # only when a second cutoff is given

Both buckets come out of a *single* walk, so they are always two views of the
same moment. That is the whole reason the second cutoff exists: the caller
used to read today's figure off the collector record, which refreshes on its
own schedule, and the five-hour window could report more tokens than the day
containing it -- impossible, and visible to the user.

Deliberately mirrors the packaged collector's accounting so the two agree:
same four token fields, same dedupe on message id, same "skip anything that
totals zero" rule.
"""

from __future__ import annotations

import datetime as dt
import json
import os
import sys
from pathlib import Path


def token_field(usage: dict, *names: str) -> int:
    for name in names:
        value = usage.get(name)
        if isinstance(value, bool):
            continue
        if isinstance(value, (int, float)):
            return int(value)
    return 0


def entry_epoch(raw) -> float | None:
    if not isinstance(raw, str) or raw == "":
        return None
    text = raw[:-1] + "+00:00" if raw.endswith("Z") else raw
    try:
        parsed = dt.datetime.fromisoformat(text)
    except ValueError:
        return None
    # A timestamp without a zone is the local clock, which is how Claude Code
    # writes them on the rare entry that omits the offset.
    if parsed.tzinfo is None:
        parsed = parsed.astimezone()
    return parsed.timestamp()


def projects_dir() -> Path:
    configured = os.environ.get("CLAUDE_CONFIG_DIR")
    base = Path(configured).expanduser() if configured else Path.home() / ".claude"
    return base / "projects"


def new_bucket(cutoff: float) -> dict:
    return {"cutoff": cutoff, "tokens": 0, "prompts": 0, "byModel": {}, "sessions": set()}


def finish_bucket(bucket: dict) -> dict:
    return {
        "tokens": bucket["tokens"],
        "prompts": bucket["prompts"],
        "byModel": bucket["byModel"],
        "sessions": len(bucket["sessions"]),
    }


def scan(cutoffs: dict) -> dict:
    """One pass over the transcripts, credited to every bucket it falls in."""
    root = projects_dir()
    buckets = {name: new_bucket(cutoff) for name, cutoff in cutoffs.items()}
    earliest = min(cutoffs.values())
    seen: set[str] = set()

    if not root.is_dir():
        return {name: finish_bucket(b) for name, b in buckets.items()}

    for path in root.rglob("*.jsonl"):
        try:
            with path.open("r", encoding="utf-8", errors="replace") as handle:
                for line_number, line in enumerate(handle, 1):
                    # Same cheap pre-filter the packaged collector uses: most
                    # lines in a transcript are not assistant turns.
                    if '"usage":' not in line:
                        continue
                    try:
                        entry = json.loads(line)
                    except Exception:
                        continue

                    message = entry.get("message")
                    message = message if isinstance(message, dict) else {}
                    if entry.get("type") != "assistant" and message.get("role") != "assistant":
                        continue

                    usage = message.get("usage") or entry.get("usage")
                    if not isinstance(usage, dict):
                        continue

                    when = entry_epoch(entry.get("timestamp") or message.get("timestamp"))
                    if when is None or when < earliest:
                        continue

                    message_id = message.get("id") or entry.get("messageId") or ""
                    key = str(message_id) if message_id else "%s:%s" % (
                        path, entry.get("uuid") or entry.get("requestId") or line_number)
                    if key in seen:
                        continue
                    seen.add(key)

                    total = (
                        token_field(usage, "input_tokens", "inputTokens")
                        + token_field(usage, "output_tokens", "outputTokens")
                        + token_field(usage, "cache_read_input_tokens", "cacheReadInputTokens")
                        + token_field(usage, "cache_creation_input_tokens", "cacheCreationInputTokens")
                    )
                    if total <= 0:
                        continue

                    model = str(message.get("model") or entry.get("model") or "claude")
                    session_id = str(entry.get("sessionId") or path)

                    for bucket in buckets.values():
                        if when < bucket["cutoff"]:
                            continue
                        bucket["byModel"][model] = bucket["byModel"].get(model, 0) + total
                        bucket["sessions"].add(session_id)
                        bucket["tokens"] += total
                        bucket["prompts"] += 1
        except OSError as exc:
            print("session-tokens: skipping %s: %s" % (path, exc), file=sys.stderr)

    return {name: finish_bucket(b) for name, b in buckets.items()}


def main() -> int:
    argv = sys.argv[1:]
    if not argv or len(argv) > 2:
        print("usage: session-tokens <session-cutoff-epoch> [today-cutoff-epoch]",
              file=sys.stderr)
        return 2

    names = ("session", "today")
    cutoffs = {}
    for name, raw in zip(names, argv):
        try:
            cutoffs[name] = float(raw)
        except ValueError:
            print("session-tokens: %s cutoff must be epoch seconds" % name, file=sys.stderr)
            return 2

    print(json.dumps(scan(cutoffs), separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
